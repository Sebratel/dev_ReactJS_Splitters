# Template processado pelo docker-entrypoint.sh via envsubst na inicialização.
# Variáveis substituídas: ${BACKEND_ORIGIN} ${GATEWAY_ORIGIN}
# Snippets condicionais (Basic Auth, AutoISP) gerados em /etc/nginx/conf.d/ pelo entrypoint.

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    tcp_nopush      on;
    keepalive_timeout 65;
    server_tokens   off;

    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/json application/javascript
                    text/javascript image/svg+xml application/wasm;

    server {
        listen 3177;
        root  /usr/share/nginx/html;
        index index.html;

        # Upload máximo: 15 MB (anexos de GMUD têm limite de 10 MB no BFF)
        client_max_body_size 15m;

        # ── Gateway Elleven / Spring Boot (/api/v1/) ──────────────────────────
        # Declarado antes de /api/ — match mais específico tem precedência.
        location /api/v1/ {
            proxy_pass             ${GATEWAY_ORIGIN};
            proxy_http_version     1.1;
            proxy_set_header       Host              $proxy_host;
            proxy_set_header       X-Real-IP         $remote_addr;
            proxy_set_header       X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header       X-Forwarded-Proto $scheme;
            # Basic Auth e X-Forwarded-Authorization gerados pelo entrypoint
            # com base em GATEWAY_BASIC_AUTH_USER / GATEWAY_BASIC_AUTH_PASSWORD.
            include /etc/nginx/conf.d/gateway-auth.conf;
            # Remove WWW-Authenticate para o browser não abrir popup nativo.
            proxy_hide_header      WWW-Authenticate;
            # Remove headers de tracing distribuído que o APM RUM acrescenta.
            proxy_set_header       traceparent              "";
            proxy_set_header       tracestate               "";
            proxy_set_header       elastic-apm-traceparent  "";
            proxy_read_timeout     120s;
            proxy_connect_timeout  10s;
            proxy_send_timeout     120s;
        }

        # ── BFF Node Express (/api/) ──────────────────────────────────────────
        location /api/ {
            proxy_pass             ${BACKEND_ORIGIN};
            proxy_http_version     1.1;
            proxy_set_header       Host              $host;
            proxy_set_header       X-Real-IP         $remote_addr;
            proxy_set_header       X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header       X-Forwarded-Proto $scheme;
            proxy_read_timeout     120s;
            proxy_connect_timeout  10s;
            proxy_send_timeout     120s;
        }

        # ── AutoISP (opcional — snippet gerado pelo entrypoint) ───────────────
        include /etc/nginx/conf.d/autoisp.conf;

        # ── Assets estáticos (hash no nome = imutáveis, cache de 1 ano) ──────
        location ~* \.(js|mjs|css|woff2?|ttf|eot|png|jpg|jpeg|gif|ico|webp|svg|map)$ {
            expires    1y;
            add_header Cache-Control "public, immutable";
            try_files  $uri =404;
            access_log off;
        }

        # ── SPA fallback ──────────────────────────────────────────────────────
        location / {
            try_files  $uri $uri/ /index.html;
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma        "no-cache";
            add_header Expires       "0";
        }
    }
}
