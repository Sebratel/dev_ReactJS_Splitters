# Variáveis do frontend (Vite). O Vite carrega `.env`, `.env.local` e, por modo, `.env.[mode]`.
# Com variáveis vazias, o `npm run dev` usa padrões em `src/shared/config/env.ts` (paths de massiva, localhost:3001 para BFF local, etc.).
# Use `.env.local` (gitignored) para sobrescrever.

# Origem do Hub (redirecionamento quando não há sessão)
VITE_HUB_ORIGIN=https://sebratel-hub.web.app

# Base do BFF (listagens massiva/splitters, etc.)
# No `npm run dev`, deixe vazio: o app chama /api/... no mesmo host e o Vite repassa ao gateway
# (VITE_BFF_PROXY_TARGET, padrão api-gateway-bff) — evita CORS. Build de produção: defina
# a URL pública se o deploy não injetar o mesmo padrão do código.
# VITE_BFF_BASE_URL=
# VITE_BFF_BASE_URL=https://api-gateway-bff.sebratel.net.br
# Opcional: alvo do proxy /api no Vite (só em dev, quando BFF base está vazia)
# VITE_BFF_PROXY_TARGET=https://api-gateway-bff.sebratel.net.br

# Opcional: GET com Bearer para montar perfil (paridade HUB_SESSION_ENDPOINT)
# VITE_HUB_SESSION_ENDPOINT=https://sebratel-hub.web.app/auth/session

# Login Google no browser (Google Identity Services).
# Use o mesmo client ID web aceito pelo Hub/BFF para emitir o ID token do usuario.
# VITE_GOOGLE_CLIENT_ID=
# Opcional: fixe a redirect URI exata cadastrada no Google Cloud.
# Ex.: VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/

# Opcional: fundo da tela de login (hero padrão — imagem split; aurora | mesh | grid | dots | minimal | noir). Também: ?bg=mesh em /login
# VITE_LOGIN_BACKGROUND=hero

# Opcional: proxy de reverse geocode (evita CORS com Nominatim no browser)
# VITE_REVERSE_GEOCODE_ENDPOINT=

# Opcional: token fixo só em dev local (hostname localhost / 192.168.x / etc.)
# VITE_DEV_SESSION_TOKEN=

# GeoGrid (portas / reservas — paridade Flutter; requer api-key no browser)
# VITE_GEOGRID_BASE_URL=https://eros.geogridmaps.com.br/sebratel/api/v3
# VITE_GEOGRID_API_KEY=

# OpenID Connect (login separado do Hub — react-oidc-context). Preencha authority + client_id para exigir login.
# Registre no IdP o Redirect URI: {origin do app}/callback (ex.: http://localhost:5173/callback).
# VITE_OIDC_AUTHORITY=https://seu-provedor.example.com/realms/seu-realm
# VITE_OIDC_CLIENT_ID=nexaview-web
# VITE_OIDC_REDIRECT_PATH=/callback
# VITE_OIDC_SCOPE=openid profile email
# Opcional: após logout OIDC (padrão = origin do app)
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# Listagem de massivas (GET no BFF — path relativo a VITE_BFF_BASE_URL; paridade MASSIVA_API_GATEWAY_LIST_ENDPOINT)
# VITE_MASSIVA_LIST_PATH=/api/v1/massivas/list

# POST de abertura de massiva no BFF (path relativo; paridade MASSIVA_API_GATEWAY_ENDPOINT no Flutter)
# Obrigatório para estado "pronto para abrir" na UI de preparação; a mutação ainda não é chamada automaticamente.
# VITE_MASSIVA_OPEN_PATH=/api/v1/massivas/open
#
# Exemplo curl (mesmo Bearer que GET listagem massivas e POST /api/v1/afetados):
# curl --location 'https://SEU_BFF/api/v1/massivas/open' \
#   --header 'Content-Type: application/json' \
#   --header 'Accept: application/json' \
#   --header 'Authorization: Bearer <SEU_TOKEN_AQUI>' \
#   --data '{"incidentStatusId":1,"personId":0,"incidentTypeId":1257,"catalogServiceId":1173,"serviceLevelAgreementId":99,"matrixType":2,"teamCode":"8.0","solicitationServiceCategory1":"MASSIVAS - 001","solicitationServiceCategory2":"","solicitationServiceCategory3":"","solicitationServiceCategory4":"","solicitationServiceCategory5":"","authenticationAccessPointCode":"CODIGO_AP","assignment":{"title":"Titulo","description":"Motivo","finalDate":"2026-04-13T21:17:00.000Z","companyPlaceId":1},"affectedUsersQuantity":0,"affectedUsers":[]}'

# POST de registro de afetados após abertura (corpo: usuarioAfetadoEntities + assignmentId).
# Para a listagem de massivas, o app faz GET por protocolo: {path}/protocol/{protocolo}
# (ex. /api/v1/afetados/protocol/1612871), usando o mesmo Bearer da sessão.
# VITE_MASSIVA_AFETADOS_PATH=/api/v1/afetados

# DELETE de encerramento da massiva (path relativo ao BFF; ex.: /api/v1/massivas/finalizar-chamado-via-api)
# VITE_MASSIVA_CLOSE_PATH=/api/v1/massivas/finalizar-chamado-via-api
#
# Corpo do encerramento (strings, como no Elleven / curl manual). Ajuste se o BFF exigir outros IDs.
# VITE_MASSIVA_CLOSE_INCIDENT_STATUS_ID=4
# VITE_MASSIVA_CLOSE_PROGRESS=0
# VITE_MASSIVA_CLOSE_PRIORITY=35
# VITE_MASSIVA_CLOSE_NOTIFICATION_TARGET=0
# VITE_MASSIVA_CLOSE_PRIVATE_REPORT=true

# Base da API de afetados para limpeza pós-encerramento.
# A limpeza usa DELETE {VITE_MASSIVA_AFFECTED_USERS_PATH}/protocol/{id}
# Se vazio, o app usa fallback para VITE_MASSIVA_AFETADOS_PATH (ex.: /api/v1/afetados).
# VITE_MASSIVA_AFFECTED_USERS_PATH=/api/v1/afetados

# AutoISP
# Produção / preview: URLs absolutas com CORS liberado para o host do app.
# VITE_AUTOISP_AUTH_ENDPOINT=https://autoisp.sebratel.net.br/api/auth/v2/request_token
# VITE_AUTOISP_EVENTS_ENDPOINT=https://autoisp.sebratel.net.br/api/massives/v1/events
#
# npm run dev: proxy em vite.config.ts — use prefixo /__autoisp (sem CORS no browser)
# VITE_AUTOISP_AUTH_ENDPOINT=/__autoisp/api/auth/v2/request_token
# VITE_AUTOISP_EVENTS_ENDPOINT=/__autoisp/api/massives/v1/events
# VITE_AUTOISP_USERNAME=
# VITE_AUTOISP_PASSWORD=

# Auto-refresh do detalhe de splitter (clientes/portas + dados técnicos), em milissegundos.
# Faixa permitida no app: 15000 até 300000. Padrão se vazio: 60000 (60s).
# VITE_SPLITTER_DETAIL_REFRESH_MS=60000

# Historico local de massivas no BFF Local (MySQL; nao usa prefixo VITE_).
# O backend local le essas variaveis de `.env.local`.
# MASSIVA_MYSQL_HOST=127.0.0.1
# MASSIVA_MYSQL_PORT=3306
# MASSIVA_MYSQL_DATABASE=DB_Massives
# MASSIVA_MYSQL_USER=
# MASSIVA_MYSQL_PASSWORD=

# --- Backend Node (pasta `server/`, `npm run dev:backend`)
# Pode usar as mesmas chaves em `.env.local` na raiz do monorepo (o server carrega `../.env.local`).
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=false
# PORT=3001
# CORS_ORIGIN=http://localhost:5173
# GEOGRID_BASE_URL=
# GEOGRID_API_KEY=
# HUB_BASE_URL=https://sebratel-hub.web.app
# DASHBOARD_KPI_CRON=0 6 * * *
# DASHBOARD_KPI_CRON_DISABLED=true

# --- Docker / Portainer (produção)
# Local: ficheiro `.env.docker` na raiz + `docker compose --env-file .env.docker up -d --build`
# (substitui ${...} no compose e nos build args do frontend).
# Portainer: não precisa do ficheiro no Git — preencha as chaves abaixo em "Environment" do stack
# (ou "Load variables from .env file" com o mesmo conteúdo).
#
# VITE_LOCAL_BFF_URL=https://splitters.suaempresa.com
# FRONTEND_PORT=8080
# (Se a porta 80 do host estiver ocupada — ex. Nginx/Traefik — use 8080 ou outra livre; no Portainer defina a mesma variável no stack.)
# BACKEND_PORT=3001
# VITE_BFF_BASE_URL=
# VITE_BFF_PROXY_TARGET=https://api-gateway-bff.sebratel.net.br
# VITE_HUB_ORIGIN=https://sebratel-hub.web.app
# VITE_GOOGLE_CLIENT_ID=
# VITE_GOOGLE_REDIRECT_URI=https://splitters.suaempresa.com/
# VITE_GEOGRID_BASE_URL=https://eros.geogridmaps.com.br/sebratel/api/v3
# VITE_GEOGRID_API_KEY=
# VITE_MASSIVA_LIST_PATH=/api/v1/massivas/recuperar-pelo-banco
# VITE_MASSIVA_OPEN_PATH=/api/v1/massivas/salvar-massiva-via-api
# VITE_MASSIVA_AFETADOS_PATH=/api/v1/afetados
# VITE_AUTOISP_AUTH_ENDPOINT=https://autoisp.sebratel.net.br/api/auth/v2/request_token
# VITE_AUTOISP_EVENTS_ENDPOINT=https://autoisp.sebratel.net.br/api/massives/v1/events
# VITE_AUTOISP_USERNAME=
# VITE_AUTOISP_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=false
# MASSIVA_MYSQL_HOST=
# MASSIVA_MYSQL_PORT=3306
# MASSIVA_MYSQL_DATABASE=
# MASSIVA_MYSQL_USER=
# MASSIVA_MYSQL_PASSWORD=
# GEOGRID_BASE_URL=https://eros.geogridmaps.com.br/sebratel/api/v3
# GEOGRID_API_KEY=
# HUB_BASE_URL=https://sebratel-hub.web.app

# Firebase Auth + Firestore (login interno do Splitters e gestao de permissoes).
# Importante: senha NAO deve ser salva no Firestore. Senhas ficam no Firebase Authentication.
# No Firestore (colecao `splitters_users`) ficam perfil, status ativo e permissoes.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
