# ==============================================================================
#  NexaView (Splitters) — Variáveis de ambiente
# ==============================================================================
#  Como funciona:
#  - Frontend (Vite): só as chaves com prefixo VITE_ chegam ao browser. O Vite
#    carrega `.env`, `.env.local` e, por modo, `.env.[mode]`. Em `npm run dev`,
#    chaves vazias usam os padrões de `src/shared/config/env.ts`.
#  - Backend (pasta `server/`): lê `process.env`. Em dev, o server carrega
#    `../.env.local` (raiz) e `server/.env`. Em produção, as chaves vêm do painel
#    "Environment" da stack no Portainer (ver docker-compose.portainer.yml).
#  - Use `.env.local` (gitignored) para sobrescrever em dev.
#
#  Apenas variáveis efetivamente lidas pelo código estão listadas aqui.
# ==============================================================================


# ------------------------------------------------------------------------------
#  FRONTEND — Núcleo (BFF / Hub)
# ------------------------------------------------------------------------------
# Origem do Hub (redirecionamento quando não há sessão).
VITE_HUB_ORIGIN=https://sebratel-hub.web.app

# Base do BFF (listagens massiva/splitters, etc.). Em `npm run dev`, deixe vazio:
# o app chama /api/... no mesmo host e o Vite repassa ao gateway (VITE_BFF_PROXY_TARGET).
# VITE_BFF_BASE_URL=https://api-gateway-bff.sebratel.net.br

# Alvo do proxy /api no Vite (só em dev, quando VITE_BFF_BASE_URL está vazio).
# VITE_BFF_PROXY_TARGET=https://api-gateway-bff.sebratel.net.br

# URL pública do SPA em produção (Docker). Vazio = mesma origem do browser para /api.
# VITE_LOCAL_BFF_URL=https://splitters.suaempresa.com

# Opcional: GET com Bearer para montar perfil (paridade HUB_SESSION_ENDPOINT).
# VITE_HUB_SESSION_ENDPOINT=https://sebratel-hub.web.app/auth/session

# Opcional: token fixo só em dev local (hostname localhost / 192.168.x / etc.).
# VITE_DEV_SESSION_TOKEN=


# ------------------------------------------------------------------------------
#  FRONTEND — Autenticação (Google / OIDC / Firebase / Acesso)
# ------------------------------------------------------------------------------
# Login Google no browser (Google Identity Services). Use o mesmo client ID web do Hub/BFF.
# VITE_GOOGLE_CLIENT_ID=
# Opcional: fixe a redirect URI exata cadastrada no Google Cloud (ex.: http://localhost:5173/).
# VITE_GOOGLE_REDIRECT_URI=

# OpenID Connect (login separado do Hub — react-oidc-context). Preencha authority + client_id para exigir login.
# Redirect URI no IdP: {origin do app}/callback.
# VITE_OIDC_AUTHORITY=https://seu-provedor.example.com/realms/seu-realm
# VITE_OIDC_CLIENT_ID=nexaview-web
# VITE_OIDC_REDIRECT_PATH=/callback
# VITE_OIDC_SCOPE=openid profile email
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# Firebase Auth + Firestore (login interno do Splitters e gestão de permissões).
# Senhas ficam no Firebase Authentication; no Firestore (coleção `splitters_users`) ficam perfil/permissões.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Controle de acesso (lista de e-mails liberados e/ou domínio permitido).
# VITE_ACCESS_ALLOWED_EMAILS=user1@empresa.com,user2@empresa.com
# VITE_ACCESS_ALLOWED_EMAIL_DOMAIN=sebratel.com.br


# ------------------------------------------------------------------------------
#  FRONTEND — Massiva (paths no BFF; relativos a VITE_BFF_BASE_URL)
# ------------------------------------------------------------------------------
# VITE_MASSIVA_LIST_PATH=/api/v1/massivas/recuperar-pelo-banco
# VITE_MASSIVA_OPEN_PATH=/api/v1/massivas/salvar-massiva-via-api
# VITE_MASSIVA_AFETADOS_PATH=/api/v1/afetados
# VITE_MASSIVA_CLOSE_PATH=/api/v1/massivas/finalizar-chamado-via-api
# Base de afetados para limpeza pós-encerramento (fallback = VITE_MASSIVA_AFETADOS_PATH).
# VITE_MASSIVA_AFFECTED_USERS_PATH=/api/v1/afetados
#
# Parâmetros do corpo de encerramento (paridade Elleven). Ajuste se o BFF exigir outros IDs.
# VITE_MASSIVA_CLOSE_INCIDENT_STATUS_ID=4
# IDs extras considerados encerrado/cancelado (vírgula): ex. 3,5
# VITE_MASSIVA_CLOSED_INCIDENT_STATUS_IDS=
# VITE_MASSIVA_CLOSE_PROGRESS=0
# VITE_MASSIVA_CLOSE_PRIORITY=35
# VITE_MASSIVA_CLOSE_NOTIFICATION_TARGET=0
# VITE_MASSIVA_CLOSE_PRIVATE_REPORT=true


# ------------------------------------------------------------------------------
#  FRONTEND — AutoISP
# ------------------------------------------------------------------------------
# Produção/preview: URLs absolutas com CORS liberado para o host do app.
# VITE_AUTOISP_AUTH_ENDPOINT=https://autoisp.sebratel.net.br/api/auth/v2/request_token
# VITE_AUTOISP_EVENTS_ENDPOINT=https://autoisp.sebratel.net.br/api/massives/v1/events
# npm run dev: use o proxy do vite.config.ts com prefixo /__autoisp (sem CORS no browser).
# VITE_AUTOISP_AUTH_ENDPOINT=/__autoisp/api/auth/v2/request_token
# VITE_AUTOISP_EVENTS_ENDPOINT=/__autoisp/api/massives/v1/events
# VITE_AUTOISP_USERNAME=
# VITE_AUTOISP_PASSWORD=


# ------------------------------------------------------------------------------
#  FRONTEND — GeoGrid e ajustes de UI
# ------------------------------------------------------------------------------
# GeoGrid (portas/reservas e sinal projetado; requer api-key no browser).
# VITE_GEOGRID_BASE_URL=https://eros.geogridmaps.com.br/sebratel/api/v3
# VITE_GEOGRID_API_KEY=

# Auto-refresh do detalhe de splitter, em ms. Faixa 15000–300000. Padrão: 60000.
# VITE_SPLITTER_DETAIL_REFRESH_MS=60000

# Proxy de reverse geocode (evita CORS com Nominatim no browser).
# VITE_REVERSE_GEOCODE_ENDPOINT=

# Opcionais visuais.
# VITE_LOGIN_BACKGROUND=hero          # hero | aurora | mesh | grid | dots | minimal | noir (ou ?bg= em /login)
# VITE_ISA_HERO_IMAGE=                 # imagem do hero do assistente ISA
# VITE_ACCESS_REQUEST_FAB_IMAGE=       # imagem do FAB de solicitação de acesso


# ------------------------------------------------------------------------------
#  FRONTEND — Elastic APM RUM (browser)
#  Desligado enquanto VITE_APM_SERVER_URL estiver vazia (o agente nem entra no bundle).
#  Precisa de um endereço alcançável pelo NAVEGADOR do utilizador final — `apm-server:8200`
#  só existe dentro do Docker. Ver docs/observabilidade-apm.md.
# ------------------------------------------------------------------------------
# VITE_APM_SERVER_URL=https://apm.sebratel.net.br
# VITE_APM_SERVICE_NAME=splitters-web
# VITE_APM_SERVICE_VERSION=
# VITE_APM_ENVIRONMENT=production


# ==============================================================================
#  BACKEND (pasta `server/`, `npm run dev:backend`)
# ==============================================================================

# ------------------------------------------------------------------------------
#  Backend — Núcleo
# ------------------------------------------------------------------------------
# PORT=3001
# NODE_ENV=production
# LOG_LEVEL=info                       # debug | info | warn | error

# ------------------------------------------------------------------------------
#  Backend — Elastic APM (Node.js)
#  Sem ELASTIC_APM_SERVER_URL o agente não arranca (o backend corre como sempre).
#  Vale para o BFF (`server/`) e para o servidor do SPA (`frontend-server.mjs`), que
#  usam o mesmo trio de variáveis — mude o SERVICE_NAME por container.
# ------------------------------------------------------------------------------
# ELASTIC_APM_SERVER_URL=http://apm-server:8200
# ELASTIC_APM_SERVICE_NAME=splitters-bff
# ELASTIC_APM_ENVIRONMENT=production
# Opcionais do agente (valem sobre os padrões do código):
# ELASTIC_APM_CAPTURE_BODY=off         # off | errors | transactions | all
# ELASTIC_APM_CAPTURE_HEADERS=false
# ELASTIC_APM_TRANSACTION_SAMPLE_RATE=1.0
# ELASTIC_APM_LOG_LEVEL=info

# ------------------------------------------------------------------------------
#  Backend — PostgreSQL principal (estatísticas de rede / dashboard)
# ------------------------------------------------------------------------------
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=false

# ------------------------------------------------------------------------------
#  Backend — PostgreSQL de monitoramento de ONUs (diagnóstico de sinal)
#  Servidor separado do principal. Sem ONU_DB_HOST, /api/onu-diagnostics responde 503.
# ------------------------------------------------------------------------------
# ONU_DB_HOST=
# ONU_DB_PORT=5432
# ONU_DB_NAME=
# ONU_DB_USER=
# ONU_DB_PASSWORD=
# ONU_DB_SSL=false
# ONU_DB_POOL_MAX=6

# ------------------------------------------------------------------------------
#  Backend — MySQL (histórico local de massivas, prompts ISA, sugestões)
# ------------------------------------------------------------------------------
# MASSIVA_MYSQL_HOST=127.0.0.1
# MASSIVA_MYSQL_PORT=3306
# MASSIVA_MYSQL_DATABASE=DB_Massives
# MASSIVA_MYSQL_USER=
# MASSIVA_MYSQL_PASSWORD=
# Cria a tabela automaticamente se não existir (use com cautela em produção).
# ISA_PROMPT_MYSQL_AUTO_CREATE_TABLE=false
# PLATFORM_SUGGESTIONS_MYSQL_AUTO_CREATE_TABLE=false
# PLATFORM_SUGGESTIONS_READ_ONLY=true
# Splitters e demais apps consumidores: somente leitura (gravacao no Hub Apps).
# No backend do Hub Apps, defina PLATFORM_SUGGESTIONS_READ_ONLY=false.
# PLATFORM_SUGGESTIONS_APP_ID=app-splitters-sebratel
#
# Sugestoes da plataforma — Hub Apps e a FONTE DA VERDADE (DB_Hub_Apps).
# Splitters e demais apps gravam/leem via HUB_APPS_MYSQL_* no BFF.
# Para replicar hub -> banco local do app (ex.: DB_Massives no Splitters):
#   node server/scripts/replicatePlatformSuggestionsFromHub.js
# Destino da replica opcional: SUGGESTIONS_REPLICA_MYSQL_* (padrao: MASSIVA_MYSQL_*).
# HUB_APPS_MYSQL_DATABASE=DB_Hub_Apps
# HUB_APPS_MYSQL_HOST=
# HUB_APPS_MYSQL_PORT=3306
# HUB_APPS_MYSQL_USER=
# HUB_APPS_MYSQL_PASSWORD=
# SUGGESTIONS_REPLICA_MYSQL_DATABASE=
# SUGGESTIONS_REPLICA_MYSQL_HOST=
# SUGGESTIONS_REPLICA_MYSQL_PORT=3306
# SUGGESTIONS_REPLICA_MYSQL_USER=
# SUGGESTIONS_REPLICA_MYSQL_PASSWORD=

# ------------------------------------------------------------------------------
#  Backend — Firebase Admin (validação de sessão / permissões)
#  Use PRIVATE_KEY (com \n) OU PRIVATE_KEY_BASE64 (recomendado em Docker).
# ------------------------------------------------------------------------------
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
# FIREBASE_ADMIN_PRIVATE_KEY_BASE64=
# VITE_FIREBASE_PROJECT_ID=            # usado como fallback do project id no backend

# ------------------------------------------------------------------------------
#  Backend — Assistente ISA (Google Gemini)
#  Sem GEMINI_API_KEY/GOOGLE_API_KEY, POST /api/isa/planning-assistant/chat responde 503.
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
#  Backend — APIs externas
# ------------------------------------------------------------------------------
# GEOGRID_BASE_URL=https://eros.geogridmaps.com.br/sebratel/api/v3
# GEOGRID_API_KEY=
# HUB_BASE_URL=https://sebratel-hub.web.app
# OSRM (vizinhos roteados / fila de planejamento). Default público pode falhar/rate-limit.
# OSRM_BASE_URL=https://router.project-osrm.org
# OSRM_TIMEOUT_MS=8000

# ------------------------------------------------------------------------------
#  Backend — Reverse geocode (rua a partir de lat/lng quando o cadastro está vazio)
#  Nominatim exige User-Agent identificável e ~1 req/s.
# ------------------------------------------------------------------------------
# REVERSE_GEOCODE_USER_AGENT=SplittersMonitoring/1.0 (suporte@suaempresa.com)
# REVERSE_GEOCODE_ENDPOINT=
# REVERSE_GEOCODE_DISABLED=true
# REVERSE_GEOCODE_TIMEOUT_MS=8000
# REVERSE_GEOCODE_MIN_INTERVAL_MS=1100
# Vizinhos no mapa (detalhe de splitter): máx. por pedido + pausa entre chamadas.
# REVERSE_GEOCODE_NEIGHBORS_MAX=4
# REVERSE_GEOCODE_NEIGHBORS_DELAY_MS=1100
# Vizinhos no snapshot do Painel da Rede (relief).
# REVERSE_GEOCODE_RELIEF_NEIGHBORS_MAX=4
# REVERSE_GEOCODE_RELIEF_NEIGHBORS_DELAY_MS=1100

# ------------------------------------------------------------------------------
#  Backend — Crons e snapshots
# ------------------------------------------------------------------------------
# Snapshot diário de KPIs do dashboard.
# DASHBOARD_KPI_CRON=0 6 * * *
# DASHBOARD_KPI_CRON_DISABLED=true
# Snapshot da base de splitters.
# SPLITTER_SNAPSHOT_CRON=
# SPLITTER_SNAPSHOT_CRON_DISABLED=true
# Snapshot do Painel da Rede (network relief).
# NETWORK_RELIEF_SNAPSHOT_CRON=
# NETWORK_RELIEF_SNAPSHOT_CRON_DISABLED=true
# NETWORK_RELIEF_SNAPSHOT_FAST_CAPTURE=false
# NETWORK_RELIEF_SNAPSHOT_GEOCODE_MAX=

# ------------------------------------------------------------------------------
#  Backend — Catálogos ERP e tuning de performance (opcionais)
# ------------------------------------------------------------------------------
# Catálogos de manutenção ERP configuráveis sem redeploy (JSON ou lista).
# MAINTENANCE_ERP_CATALOGS=
# Tamanho de lote da rota de massivas em batch.
# MASSIVA_BATCH_ROUTE_CHUNK_SIZE=
# Prioridade operacional (paginação e concorrência).
# OPERATIONAL_PRIORITY_PAGE_SIZE=
# OPERATIONAL_PRIORITY_PAGE_CONCURRENCY=
# OPERATIONAL_PRIORITY_MASSIVA_CHUNK=
# OPERATIONAL_PRIORITY_MASSIVA_CONCURRENCY=


# ==============================================================================
#  Docker / Portainer (produção)
# ==============================================================================
#  As chaves acima (frontend VITE_* + backend) são definidas no painel
#  "Environment" da stack. Adicionalmente:
# ------------------------------------------------------------------------------
# FRONTEND_PORT=3177                   # porta do SPA no host (se 3177 ocupada, use outra)
# BACKEND_PORT=3001                    # porta do backend no host
# BACKEND_ORIGIN=http://backend:3001   # proxy interno do SPA → backend Node
# GATEWAY_ORIGIN=https://api-gateway-bff.sebratel.net.br
# Se o gateway exige HTTP Basic (ex. admin/admin no staging), defina no frontend — o proxy
# envia o Basic server-side e repassa o JWT Google em X-Forwarded-Authorization (sem popup).
# GATEWAY_BASIC_AUTH_USER=admin
# GATEWAY_BASIC_AUTH_PASSWORD=admin
