# Configurações para Stack NexaView no Portainer
# 
# Instruções:
# 1. Crie um arquivo .env.portainer.example com essas variáveis
# 2. No Portainer, configure essas variáveis de ambiente na stack
# 3. Ajuste os valores conforme sua infraestrutura
# 
# ========== OBRIGATÓRIO ==========

# Imagens Docker (publicadas no Docker Hub)
BACKEND_IMAGE=seu-usuario/nexaview-backend:latest
FRONTEND_IMAGE=seu-usuario/nexaview-frontend:latest

# MySQL Remoto
MASSIVA_MYSQL_HOST=10.0.11.171
MASSIVA_MYSQL_PORT=3306
MASSIVA_MYSQL_DATABASE=DB_Massives
MASSIVA_MYSQL_USER=DevSebratel
MASSIVA_MYSQL_PASSWORD=DevBI*24

# ========== ÓTIMO CONFIGURAR ==========

# PostgreSQL (opcional - deixe vazio se não usar)
DB_HOST=
DB_PORT=5432
DB_NAME=nexaview
DB_USER=
DB_PASSWORD=
DB_SSL=false

# Priorização operacional (/api/splitters/operational-priority): opcional — páginas PG paralelas + chunks MySQL
# OPERATIONAL_PRIORITY_PAGE_SIZE=2500
# OPERATIONAL_PRIORITY_PAGE_CONCURRENCY=6
# OPERATIONAL_PRIORITY_MASSIVA_CHUNK=800
# OPERATIONAL_PRIORITY_MASSIVA_CONCURRENCY=4

# APIs Externas - GeoGrid
VITE_GEOGRID_BASE_URL=https://eros.geogridmaps.com.br/sebratel/api/v3
VITE_GEOGRID_API_KEY=seu-api-key-aqui

# APIs Externas - Hub
HUB_BASE_URL=https://sebratel-hub.web.app

# APIs Externas - AutoISP
AUTOISP_AUTH_ENDPOINT=https://autoisp.sebratel.net.br/api/auth/v2/request_token
AUTOISP_EVENTS_ENDPOINT=https://autoisp.sebratel.net.br/api/massives/v1/events
AUTOISP_USERNAME=api@sebratel.com.br
AUTOISP_PASSWORD=sua-senha-autoisp

# APIs Externas - Massiva
VITE_MASSIVA_LIST_PATH=/api/v1/massivas/recuperar-pelo-banco
VITE_MASSIVA_OPEN_PATH=/api/v1/massivas/salvar-massiva-via-api
VITE_MASSIVA_AFETADOS_PATH=/api/v1/afetados

# Google OAuth — tem de ser o MESMO Web Client ID que o gateway valida no JWT (`aud`) e o
# configurado em Firebase Authentication > Sign-in method > Google (Web client ID).
VITE_GOOGLE_CLIENT_ID=seu-client-id-aqui
VITE_GOOGLE_REDIRECT_URI=https://seu-dominio.com/callback

# Firebase (Auth + Firestore) — obrigatório para login Google e gestão de usuários no app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional: lista fixa (vírgulas, minúsculas) ou vazio
VITE_ACCESS_ALLOWED_EMAILS=
# Domínio corporativo permitido (ex.: sebratel.com.br, sem @)
VITE_ACCESS_ALLOWED_EMAIL_DOMAIN=sebratel.com.br
# Opcional: ícone do botão flutuante "Solicitar acesso" — path em public (ex. /fab-acesso.png) ou URL https
VITE_ACCESS_REQUEST_FAB_IMAGE=

# Frontend URLs
VITE_LOCAL_BFF_URL=http://backend:3001
VITE_BFF_BASE_URL=
VITE_BFF_PROXY_TARGET=https://api-gateway-bff-staging.sebratel.net.br
# Auto-refresh do detalhe de splitter (clientes/portas + dados técnicos), em ms
VITE_SPLITTER_DETAIL_REFRESH_MS=60000

# ========== OPCIONAL (Dev/Staging) ==========

# Desenvolvimento Local
LOCAL_USER_EMAIL=dev@local
LOCAL_USER_PERSON_ID=629
LOCAL_MASSIVA_ENABLED=true

# Token JWT para desenvolvimento (test mode, sem OIDC)
VITE_DEV_SESSION_TOKEN=seu-jwt-token-aqui

# ERP / Credenciais Sensíveis (use secrets do Portainer)
ERP_CLIENT_ID=ad0c5d9a-fad1-4ca9-8d1e-cff2cedb3146
ERP_CLIENT_SECRET=sua-secret-aqui
ERP_SYNDATA=sua-syndata-aqui

# ========== PROXY / REVERSE ==========

# Se usar Traefik/Nginx:
# TRAEFIK_HOST=seu-dominio.com
# TRAEFIK_CERTIFICATE_EMAIL=seu-email@example.com

# ========== MONITORAMENTO (Opcional) ==========

# Datadog
# DD_API_KEY=sua-datadog-api-key
# DD_ENVIRONMENT=production
# DD_SERVICE=nexaview

# New Relic
# NEW_RELIC_LICENSE_KEY=sua-nr-key
# NEW_RELIC_APP_NAME=nexaview-production