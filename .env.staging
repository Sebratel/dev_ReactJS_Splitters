# Staging build for Firebase Hosting: app-splitters-staging

# BFF base used by bffClient in staging/prod.
# Keep this in sync with your staging gateway.
VITE_BFF_BASE_URL=https://api-gateway-bff.sebratel.net.br

# SQL/aux endpoints used by splitters, stats, clientes and massiva-history.
# Must be reachable from browser in staging (never localhost).
VITE_LOCAL_BFF_URL=https://api-gateway-bff.sebratel.net.br

# Google browser auth (staging OAuth client)
VITE_GOOGLE_CLIENT_ID=374233629278-383pi1ga2ta3sge34nkd5sggpulq8qbc.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=https://app-splitters-staging.web.app/

# Optional but recommended for consistency with current environment.
VITE_HUB_ORIGIN=https://sebratel-hub.web.app

# Massiva paths (relative to VITE_BFF_BASE_URL)
VITE_MASSIVA_LIST_PATH=/api/v1/massivas/recuperar-pelo-banco
VITE_MASSIVA_OPEN_PATH=/api/v1/massivas/salvar-massiva-via-api
VITE_MASSIVA_AFETADOS_PATH=/api/v1/afetados
VITE_MASSIVA_AFFECTED_USERS_PATH=/api/v1/afetados
VITE_MASSIVA_CLOSE_PATH=/api/v1/massivas/finalizar-chamado-via-api
