# Build do bundle Vite. Variáveis VITE_* vêm de build args (Portainer/CI ou
# `docker compose --env-file .env.docker` com os mesmos nomes no ficheiro).
# Não é necessário o ficheiro .env.docker no contexto do Git.
#
# Imagem de build: Debian slim (glibc) em vez de Alpine — evita falhas comuns do
# Tailwind 4 / lightningcss / Vite em musl e reduz surpresas entre hosts (Portainer).

FROM node:22-bookworm-slim AS builder
WORKDIR /app

COPY package*.json ./
# `npm config set production` está deprecated / falha no npm 9+; --include=dev
# força devDependencies (Vite, Tailwind, etc.) mesmo com NODE_ENV=production no build.
RUN npm ci --include=dev

COPY . .

ARG VITE_LOCAL_BFF_URL
ARG VITE_BFF_BASE_URL
ARG VITE_BFF_PROXY_TARGET
ARG VITE_HUB_ORIGIN
ARG VITE_HUB_SESSION_ENDPOINT
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_GOOGLE_REDIRECT_URI
ARG VITE_REVERSE_GEOCODE_ENDPOINT
ARG VITE_DEV_SESSION_TOKEN
ARG VITE_GEOGRID_BASE_URL
ARG VITE_GEOGRID_API_KEY
ARG VITE_MASSIVA_LIST_PATH
ARG VITE_MASSIVA_OPEN_PATH
ARG VITE_MASSIVA_CLOSE_PATH
ARG VITE_MASSIVA_AFETADOS_PATH
ARG VITE_MASSIVA_AFFECTED_USERS_PATH
ARG VITE_MASSIVA_CLOSE_INCIDENT_STATUS_ID
ARG VITE_MASSIVA_CLOSE_PROGRESS
ARG VITE_MASSIVA_CLOSE_PRIORITY
ARG VITE_MASSIVA_CLOSE_NOTIFICATION_TARGET
ARG VITE_MASSIVA_CLOSE_PRIVATE_REPORT
ARG VITE_OIDC_AUTHORITY
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_REDIRECT_PATH
ARG VITE_OIDC_SCOPE
ARG VITE_OIDC_POST_LOGOUT_REDIRECT_URI
ARG VITE_AUTOISP_AUTH_ENDPOINT
ARG VITE_AUTOISP_EVENTS_ENDPOINT
ARG VITE_AUTOISP_USERNAME
ARG VITE_AUTOISP_PASSWORD

ENV VITE_LOCAL_BFF_URL=$VITE_LOCAL_BFF_URL
ENV VITE_BFF_BASE_URL=$VITE_BFF_BASE_URL
ENV VITE_BFF_PROXY_TARGET=$VITE_BFF_PROXY_TARGET
ENV VITE_HUB_ORIGIN=$VITE_HUB_ORIGIN
ENV VITE_HUB_SESSION_ENDPOINT=$VITE_HUB_SESSION_ENDPOINT
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_REDIRECT_URI=$VITE_GOOGLE_REDIRECT_URI
ENV VITE_REVERSE_GEOCODE_ENDPOINT=$VITE_REVERSE_GEOCODE_ENDPOINT
ENV VITE_DEV_SESSION_TOKEN=$VITE_DEV_SESSION_TOKEN
ENV VITE_GEOGRID_BASE_URL=$VITE_GEOGRID_BASE_URL
ENV VITE_GEOGRID_API_KEY=$VITE_GEOGRID_API_KEY
ENV VITE_MASSIVA_LIST_PATH=$VITE_MASSIVA_LIST_PATH
ENV VITE_MASSIVA_OPEN_PATH=$VITE_MASSIVA_OPEN_PATH
ENV VITE_MASSIVA_CLOSE_PATH=$VITE_MASSIVA_CLOSE_PATH
ENV VITE_MASSIVA_AFETADOS_PATH=$VITE_MASSIVA_AFETADOS_PATH
ENV VITE_MASSIVA_AFFECTED_USERS_PATH=$VITE_MASSIVA_AFFECTED_USERS_PATH
ENV VITE_MASSIVA_CLOSE_INCIDENT_STATUS_ID=$VITE_MASSIVA_CLOSE_INCIDENT_STATUS_ID
ENV VITE_MASSIVA_CLOSE_PROGRESS=$VITE_MASSIVA_CLOSE_PROGRESS
ENV VITE_MASSIVA_CLOSE_PRIORITY=$VITE_MASSIVA_CLOSE_PRIORITY
ENV VITE_MASSIVA_CLOSE_NOTIFICATION_TARGET=$VITE_MASSIVA_CLOSE_NOTIFICATION_TARGET
ENV VITE_MASSIVA_CLOSE_PRIVATE_REPORT=$VITE_MASSIVA_CLOSE_PRIVATE_REPORT
ENV VITE_OIDC_AUTHORITY=$VITE_OIDC_AUTHORITY
ENV VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID
ENV VITE_OIDC_REDIRECT_PATH=$VITE_OIDC_REDIRECT_PATH
ENV VITE_OIDC_SCOPE=$VITE_OIDC_SCOPE
ENV VITE_OIDC_POST_LOGOUT_REDIRECT_URI=$VITE_OIDC_POST_LOGOUT_REDIRECT_URI
ENV VITE_AUTOISP_AUTH_ENDPOINT=$VITE_AUTOISP_AUTH_ENDPOINT
ENV VITE_AUTOISP_EVENTS_ENDPOINT=$VITE_AUTOISP_EVENTS_ENDPOINT
ENV VITE_AUTOISP_USERNAME=$VITE_AUTOISP_USERNAME
ENV VITE_AUTOISP_PASSWORD=$VITE_AUTOISP_PASSWORD

# Memoria em hosts pequenos; ajuste se o build ainda falhar (heap OOM).
ENV NODE_OPTIONS=--max-old-space-size=6144
# Apenas o bundle: `tsc -b` a falhar em Linux/CI (só aí) bloqueava o deploy; o typecheck
# continua no `npm run build` e `npm run typecheck` local/CI. Ver README.
ENV NODE_ENV=production
RUN npx vite build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/vite.config.* ./
ENV NODE_ENV=production
EXPOSE 5173
CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "5173"]
