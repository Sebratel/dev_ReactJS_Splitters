# Carregado automaticamente em `npm run dev` (Vite mode development).
# Sobrescreva com `.env.local` (gitignored) se precisar de outro BFF ou token de dev.

# BFF: deixe vazio no dev para usar o proxy em vite.config (mesmo host → /api/… → gateway, sem CORS).
# Para forçar URL absoluta no browser, descomente (e exija CORS no BFF para localhost).
# VITE_BFF_BASE_URL=https://api-gateway-bff.sebratel.net.br
VITE_BFF_BASE_URL=

VITE_MASSIVA_LIST_PATH=/api/v1/massivas/recuperar-pelo-banco
VITE_MASSIVA_OPEN_PATH=/api/v1/massivas/salvar-massiva-via-api
VITE_MASSIVA_AFETADOS_PATH=/api/v1/afetados
# Encerramento: após fechar protocolo, limpa afetados em DELETE {path}/protocol/{id}.
VITE_MASSIVA_AFFECTED_USERS_PATH=/api/v1/afetados
VITE_MASSIVA_CLOSE_PATH=/api/v1/massivas/finalizar-chamado-via-api

# Opcional: token JWT para testar sem OIDC no localhost (mesmo valor do Insomnia/curl).
# VITE_DEV_SESSION_TOKEN=

# BFF local (SQL splitters/clientes) — `npm run dev` sobe o server na 3001.
VITE_LOCAL_BFF_URL=http://localhost:3001
