# Logs
logs
*.log
*.err.log
npm-debug.log*

# Dependency directories
node_modules
dist
dist-ssr
coverage
*.tsbuildinfo
.firebase/
# Artefactos: o tsconfig.node.json tem `declaration: true`, por isso o `tsc -b` emite .d.ts
# soltos na raiz. É esse lixo que esta regra existe para apanhar — não o código-fonte.
**/*.d.ts
# ...e as declarações escritas à mão (tipos do Vite, libs sem tipos) TÊM de ir para o repo,
# senão o `tsc -b` falha em qualquer clone limpo e o CI nasce vermelho.
!src/**/*.d.ts

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.docker
.env.*.local

# Secrets / service accounts — NUNCA versionar
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json
*.pem
*.key
*.p12
*.p8
secrets/
changelog-splitters-*.docx

